# ============================================================
# Conduit — Agent Observability Platform
# ============================================================

# ── Compiled Binaries ────────────────────────────────────────
*.exe
*.out
*.test

# ── Certificates & Keys (never commit — regenerate with scripts/gen-certs.sh) ──
certs/

# ── Go ───────────────────────────────────────────────────────
vendor/
coverage.out
coverage.html
*.prof
go.sum.bak

# ── Python SDK ───────────────────────────────────────────────
sdk/python/__pycache__/
sdk/python/*.pyc
sdk/python/*.pyo
sdk/python/.venv/
sdk/python/dist/
sdk/python/*.egg-info/
sdk/python/.pytest_cache/
sdk/python/.mypy_cache/
sdk/python/.ruff_cache/

# ── Protobuf generated files ─────────────────────────────────
# Generated code IS committed: Go (proto/*.pb.go) and the Python SDK's stubs
# (sdk/python/src/conduit_observability/_proto). Regenerate both with `make proto`
# after editing .proto files; CI fails if they drift.
proto/gen/

# ── Local environment ────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Docker & Compose ─────────────────────────────────────────
deployments/docker/.env
# Keep compose file and Dockerfile tracked
!deployments/docker/docker-compose.yml
!deployments/docker/Dockerfile

# ── ClickHouse local data ────────────────────────────────────
deployments/local/clickhouse/
deployments/local/nats/
deployments/local/tempo/
deployments/local/victoriametrics/

# ── IDE & Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Test artifacts ───────────────────────────────────────────
testdata/generated/
*.log
*.tmp
# Build output and locally installed tools
bin/

# Local UI credentials for docker compose
deployments/docker/ui-users

# Python bytecode and tool caches, anywhere
__pycache__/
*.py[co]
.pytest_cache/

# Python SDK build artifacts
sdk/python/dist/
sdk/python/.venv-build/

# Quickstart: generated secrets and credentials
deployments/quickstart/.env
deployments/quickstart/.conduit/
